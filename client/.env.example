# React frontend — LOCAL DEVELOPMENT template.
# Copy this file to .env and fill in values. Never commit .env.
#
# Usage:
#   cp client/.env.example client/.env
#   (then edit client/.env as needed)

# ── CRA dev-server settings ───────────────────────────────────────────────
# Bind CRA to localhost so the browser Origin header is always http://localhost:3000.
# Without HOST=localhost, CRA may bind to 0.0.0.0 and the Origin can vary,
# which causes backend CORS rejections.
HOST=localhost

# Prevent CRA from auto-opening a browser tab on every `npm start`.
BROWSER=none

# Allow the CRA dev-server to serve requests from localhost variants.
# Needed when your machine hostname or WSL network differs from "localhost".
DANGEROUSLY_DISABLE_HOST_CHECK=true

# ── GeoServer base URL ────────────────────────────────────────────────────
# LOCAL DEV:
#   Point to the local Node backend which proxies to the shared GeoServer.
#   The backend proxy is configured via GEOSERVER_PROXY_TARGET in server/.env.
#
# PRODUCTION (Nginx):
#   Use /geoserver — Nginx handles it directly, no backend proxy needed.
#
REACT_APP_GEOSERVER_BASE=http://localhost:8060/geoserver

# Optional: only set if Phase-2 layers live on a different GeoServer instance.
# REACT_APP_PHASE2_GEOSERVER_BASE=
