# Base URL the React app uses to reach GeoServer (WMS/WFS).
#
# LOCAL DEV (CRA at http://localhost:3000):
#   Use the absolute URL of the GeoServer LB so the browser bypasses CRA's dev server.
#   REACT_APP_GEOSERVER_BASE=http://27.100.38.133/geoserver
#
# PRODUCTION (served behind Nginx alongside the API):
#   Use a relative path so it works across hosts and HTTPS.
#   REACT_APP_GEOSERVER_BASE=/geoserver
#
# Default below is the local-dev value; change to /geoserver before running `npm run build` for prod.
REACT_APP_GEOSERVER_BASE=http://27.100.38.133/geoserver

# Optional: only set this if Phase-2 layers live on a different GeoServer.
# Otherwise the app falls back to REACT_APP_GEOSERVER_BASE for both phases.
# REACT_APP_PHASE2_GEOSERVER_BASE=
