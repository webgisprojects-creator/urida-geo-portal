{
  "database": "nv_allnndb",
  "port": 5432,
  "user": "mv_sync_job",
  "definitions": "definitions",
  "lock_file": "/run/mv-sync/lock",
  "disk_path": "/var/lib/postgresql",
  "min_free_gb": 20,
  "build_timeout": "45min",
  "max_row_drop": 0.2,
  "max_failures": 3,
  "stale_alert_seconds": 1800,
  "retry_seconds": 300,
  "overdue_seconds": 3600,
  "groups": {
    "fast":   { "quiet": 180, "max_wait": 900,  "min_gap": 600,  "window": null },
    "medium": { "quiet": 600, "max_wait": 3600, "min_gap": 1800, "window": null },
    "heavy":  { "quiet": 600, "max_wait": 600,  "min_gap": 43200, "window": [20, 23] }
  },
  "geoserver": {
    "url": "",
    "credentials_file": "/etc/mv-sync/geoserver.credentials"
  }
}
