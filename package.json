{
  "name": "urida-geo-portal",
  "version": "1.0.0",
  "private": true,
  "description": "URIDA Geo Portal — GIS portal for urban infrastructure across 17 cities in Uttar Pradesh.",
  "scripts": {
    "setup": "node scripts/setup-dev.js",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client start",
    "build:client": "npm --prefix client run build",
    "start:prod": "node server/src/server.js",
    "pm2:start": "pm2 start deploy/ecosystem.config.js",
    "pm2:reload": "pm2 reload deploy/ecosystem.config.js",
    "pm2:stop": "pm2 stop deploy/ecosystem.config.js",
    "pm2:logs": "pm2 logs urida-backend"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/webgisprojects-creator/urida-geo-portal.git"
  },
  "license": "UNLICENSED"
}
