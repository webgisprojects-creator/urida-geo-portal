# Server runtime
NODE_ENV=development
PORT=8060

# CORS
# Comma-separated list of allowed frontend origins.
# Keep production IPs/domains only in the real server .env file, not in GitHub.
CORS_ORIGINS=http://localhost:3000,http://localhost:8060

# PostgreSQL / PostGIS
# Do not commit real production credentials.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_app_user
DB_PASS=your_local_password
DB_NAME=your_database_name

# Pool tuning
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=20000

# GeoServer reverse proxy target
# Local example:
#   GEOSERVER_PROXY_TARGET=http://localhost:8080/geoserver
#
# Production should be configured only in the real server .env file.
GEOSERVER_PROXY_TARGET=http://localhost:8080/geoserver

# Auth
# Generate a strong random secret:
#   openssl rand -hex 64
JWT_SECRET=replace_with_long_random_local_secret
