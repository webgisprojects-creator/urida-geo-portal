# Backend — LOCAL DEVELOPMENT template.
# Copy this file to server/.env and fill in your values.
# Never commit server/.env — it is gitignored.
#
# Usage:
#   cp server/.env.example server/.env
#   (then edit server/.env with real values given by the team lead)

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8060

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of browser Origins the backend will accept.
# For local dev, include every localhost variant your browser might send.
# If login fails with a CORS error, check:
#   DevTools → Network → login request → Request Headers → Origin
# and add that exact value here, then restart the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8060,http://127.0.0.1:8060

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────
# Ask the team lead for the correct host, credentials, and database name.
# Use the developer role for day-to-day work, not the app/production role.
# Do NOT put production credentials here.
DB_HOST=replace_with_db_host
DB_PORT=5432
DB_USER=replace_with_dev_user
DB_PASS=replace_with_dev_password
DB_NAME=replace_with_db_name

# ── DB pool tuning (leave as-is for local dev) ───────────────────────────
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=20000

# ── GeoServer proxy target ────────────────────────────────────────────────
# The Node backend proxies all /geoserver/* requests to this URL.
# For local dev, use the shared pre-production GeoServer (ask team lead for IP).
# Do NOT use the production GeoServer URL in local dev.
#
# Shared dev GeoServer example:  https://<dev-server-ip>/geoserver
# Local GeoServer example:        http://localhost:8080
#
GEOSERVER_PROXY_TARGET=replace_with_geoserver_url

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a strong random secret — never reuse the production secret locally.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or: openssl rand -hex 64
JWT_SECRET=replace_with_long_random_local_secret
