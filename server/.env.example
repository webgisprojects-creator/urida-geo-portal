# ────────────────────────────────────────────────────────────────
# Server runtime
# ────────────────────────────────────────────────────────────────
NODE_ENV=development          # use "production" on the prod server
PORT=8060

# ────────────────────────────────────────────────────────────────
# PostgreSQL (PostgreSQL + PostGIS)
# Prod DB lives at 27.100.38.132:5432, db = nv_allnndb
# ────────────────────────────────────────────────────────────────
DB_HOST=27.100.38.132
DB_PORT=5432
DB_USER=nv_allnndb_app
DB_PASS=PUT_REAL_PASSWORD_HERE
DB_NAME=nv_allnndb

# Pool tuning. Use 5 locally, 10+ in prod.
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=20000

# ────────────────────────────────────────────────────────────────
# GeoServer
# Backend reverse-proxies /geoserver/* to this target.
# Production GeoServer (behind Nginx LB): http://27.100.38.133
# ────────────────────────────────────────────────────────────────
GEOSERVER_PROXY_TARGET=http://27.100.38.133

# ────────────────────────────────────────────────────────────────
# Auth
# Generate a strong random secret, e.g.: openssl rand -hex 64
# ────────────────────────────────────────────────────────────────
JWT_SECRET=PUT_LONG_RANDOM_LOCAL_SECRET_HERE
